{
  "version": 2,
  "rewrites": [
    { "source": "/api/custom-images", "destination": "/api/custom-images.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
